{
    "$id": "CreateAnnotationsRequestBody",
    "type": "object",
    "additionalProperties": false,
    "required": ["annotations"],
    "properties": {
        "annotations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema", "access"],
                "properties": {
                    "schema": {
                        "description": "name@version of an existing annotation schema",
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}@[1-9][0-9]*$"
                    },
                    "start_seconds": { "type": "number", "minimum": 0 },
                    "duration_seconds": { "type": "number", "minimum": 0 },
                    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 256 },
                    "text": { "type": "string", "maxLength": 100000 },
                    "vector": { "type": "array", "items": { "type": "number" }, "maxItems": 2000 },
                    "kv": { "type": "object" },
                    "blob": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["url", "content_type"],
                        "properties": {
                            "url": { "type": "string", "format": "uri", "maxLength": 2048 },
                            "content_type": { "type": "string", "maxLength": 255 }
                        }
                    },
                    "data": {
                        "description": "Free-form data, validated against the schema's json_schema when it has one"
                    },
                    "access": {
                        "description": "null: only the creator; \"*\": any authenticated user; [ids]: these users (and the creator)",
                        "oneOf": [
                            { "type": "null" },
                            { "type": "string", "const": "*" },
                            {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 1000,
                                "items": { "type": "integer", "minimum": 1 }
                            }
                        ]
                    }
                }
            }
        }
    }
}
