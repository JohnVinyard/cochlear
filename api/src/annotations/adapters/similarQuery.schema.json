{
    "$id": "SimilarAnnotationsQuery",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "limit": { "description": "how many (1-500, default 100)", "type": "string", "pattern": "^(?:[1-9][0-9]?|[1-4][0-9]{2}|500)$" },
        "exclude_same_sound": { "description": "leave out annotations on the query's own sound", "enum": ["true", "false"] }
    }
}
