{
    "$id": "CreateApiKeyRequestBody",
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "roles"],
    "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "SOUND_READER",
                    "ANNOTATION_READER",
                    "ANNOTATION_SCHEMA_READER",
                    "SOUND_EDITOR",
                    "ANNOTATION_EDITOR",
                    "ANNOTATION_SCHEMA_CREATOR",
                    "API_KEY_CREATOR"
                ]
            }
        }
    }
}
