{
    "$id": "CreateAnnotationSchemaRequestBody",
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "kind"],
    "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "kind": { "type": "string", "enum": ["tags", "text", "vector", "kv", "blob"] },
        "vector_dim": { "type": ["integer", "null"], "minimum": 1, "maximum": 2000 },
        "json_schema": { "type": ["object", "null"] },
        "description": { "type": "string", "maxLength": 10000 }
    }
}
