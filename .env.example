# Copy to .env to override the host ports docker compose publishes.
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=5173
# FIREBASE_AUTH_PORT=9099
# FIREBASE_UI_PORT=4000
# GCS_PORT=4443

# Local copies of datasets, mounted read-only into featurebot at /audio, so it
# reads e.g. MusicNet's audio from disk rather than downloading it (~20 GB).
# Expects musicnet/{train,test}_data/<id>.wav underneath.
# AUDIO_DATA_DIR=~/workspace/audio-data
