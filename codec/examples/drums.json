{
  "$schema": "../schema/document.schema.json",
  "format": "cochlea-codec",
  "version": "0.2",
  "meta": {
    "description": "Fours all the way down: a song of 4 phrases, a phrase of 4 bars, a bar of 4 beats, a beat of a few hits. Each sound and pattern is defined once, in defs, and used with $ref. Kick and snare come from URLs, the hi-hat from a data: URI; envelope, band-pass and room reverb; the fills are bars at double time, via a nested sequencer's speed. Try <codec-viewer>'s max-depth from 0 to 4."
  },
  "defs": {
    "hat-sample": "data:audio/wav;base64,",
    "hat-filter": {
      "type": "bandpass",
      "center_frequency": 9000,
      "bandwidth": 6000
    },
    "kick": {
      "type": "sampler",
      "label": "kick",
      "url": "https://one-laptop-per-child.s3.amazonaws.com/tamtam44old/drum1kick.wav",
      "gain": 0.9
    },
    "snare": {
      "type": "sampler",
      "label": "snare",
      "url": "https://one-laptop-per-child.s3.amazonaws.com/tamtam44old/drum1snare.wav",
      "gain": 0.7,
      "envelope": {
        "type": "exponential",
        "points": [
          {
            "time_seconds": 0,
            "gain": 1
          },
          {
            "time_seconds": 0.35,
            "gain": 0.001
          }
        ]
      },
      "convolve": {
        "url": "https://matching-pursuit-reverbs.s3.amazonaws.com/Nice+Drum+Room.wav",
        "mix": 0.35
      }
    },
    "hat": {
      "type": "sampler",
      "label": "hat",
      "url": {
        "$ref": "#/defs/hat-sample"
      },
      "gain": 0.5,
      "filter": {
        "$ref": "#/defs/hat-filter"
      }
    },
    "hat-soft": {
      "type": "sampler",
      "label": "hat (soft)",
      "url": {
        "$ref": "#/defs/hat-sample"
      },
      "gain": 0.25,
      "filter": {
        "$ref": "#/defs/hat-filter"
      }
    },
    "downbeat": {
      "type": "sequencer",
      "label": "beat: kick",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/kick"
          }
        },
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/hat"
          }
        },
        {
          "time_seconds": 0.25,
          "node": {
            "$ref": "#/defs/hat-soft"
          }
        }
      ]
    },
    "backbeat": {
      "type": "sequencer",
      "label": "beat: kick + snare",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/kick"
          }
        },
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/snare"
          }
        },
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/hat"
          }
        },
        {
          "time_seconds": 0.25,
          "node": {
            "$ref": "#/defs/hat-soft"
          }
        }
      ]
    },
    "pickup": {
      "type": "sequencer",
      "label": "beat: kick + snare, pickup",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/kick"
          }
        },
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/snare"
          }
        },
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/hat"
          }
        },
        {
          "time_seconds": 0.25,
          "node": {
            "$ref": "#/defs/snare"
          }
        }
      ]
    },
    "bar": {
      "type": "sequencer",
      "label": "bar",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/downbeat",
            "label": "beat 1"
          }
        },
        {
          "time_seconds": 0.5,
          "node": {
            "$ref": "#/defs/backbeat",
            "label": "beat 2"
          }
        },
        {
          "time_seconds": 1.0,
          "node": {
            "$ref": "#/defs/downbeat",
            "label": "beat 3"
          }
        },
        {
          "time_seconds": 1.5,
          "node": {
            "$ref": "#/defs/backbeat",
            "label": "beat 4"
          }
        }
      ]
    },
    "bar-pickup": {
      "type": "sequencer",
      "label": "bar",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/downbeat",
            "label": "beat 1"
          }
        },
        {
          "time_seconds": 0.5,
          "node": {
            "$ref": "#/defs/backbeat",
            "label": "beat 2"
          }
        },
        {
          "time_seconds": 1.0,
          "node": {
            "$ref": "#/defs/downbeat",
            "label": "beat 3"
          }
        },
        {
          "time_seconds": 1.5,
          "node": {
            "$ref": "#/defs/pickup",
            "label": "beat 4"
          }
        }
      ]
    },
    "fill": {
      "type": "sequencer",
      "label": "fill (double time)",
      "speed": 2,
      "events": [
        {
          "time_seconds": 0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 1"
          }
        },
        {
          "time_seconds": 2.0,
          "node": {
            "$ref": "#/defs/bar-pickup",
            "label": "bar 2"
          }
        }
      ]
    },
    "phrase": {
      "type": "sequencer",
      "label": "phrase",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 1"
          }
        },
        {
          "time_seconds": 2.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 2"
          }
        },
        {
          "time_seconds": 4.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 3"
          }
        },
        {
          "time_seconds": 6.0,
          "node": {
            "$ref": "#/defs/bar-pickup",
            "label": "bar 4"
          }
        }
      ]
    },
    "phrase-fill": {
      "type": "sequencer",
      "label": "phrase",
      "events": [
        {
          "time_seconds": 0.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 1"
          }
        },
        {
          "time_seconds": 2.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 2"
          }
        },
        {
          "time_seconds": 4.0,
          "node": {
            "$ref": "#/defs/bar",
            "label": "bar 3"
          }
        },
        {
          "time_seconds": 6.0,
          "node": {
            "$ref": "#/defs/fill",
            "label": "bar 4"
          }
        }
      ]
    }
  },
  "root": {
    "type": "sequencer",
    "label": "song",
    "events": [
      {
        "time_seconds": 0.0,
        "node": {
          "$ref": "#/defs/phrase",
          "label": "phrase 1"
        }
      },
      {
        "time_seconds": 8.0,
        "node": {
          "$ref": "#/defs/phrase-fill",
          "label": "phrase 2"
        }
      },
      {
        "time_seconds": 16.0,
        "node": {
          "$ref": "#/defs/phrase",
          "label": "phrase 3"
        }
      },
      {
        "time_seconds": 24.0,
        "node": {
          "$ref": "#/defs/phrase-fill",
          "label": "phrase 4"
        }
      }
    ]
  }
}
