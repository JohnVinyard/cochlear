{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "cochlea codec document",
    "description": "Audio described as a tree of parameters for a pluggable decoder. See codec/SPEC.md.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "format",
        "version",
        "root"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "format": {
            "const": "cochlea-codec"
        },
        "version": {
            "type": "string",
            "pattern": "^0\\.[0-9]+$"
        },
        "requires": {
            "type": "object",
            "description": "Modules (by type) and minimum versions this document needs, e.g. {\"org.example.theremin\": \"0.1\"}. Decoders fail up front if they lack one.",
            "propertyNames": {
                "$ref": "#/$defs/type"
            },
            "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
            }
        },
        "defs": {
            "type": "object",
            "description": "Definitions: any values (nodes, URIs, envelopes, patterns...) that can be used many times with {\"$ref\": \"#/defs/name\"}"
        },
        "root": {
            "$ref": "#/$defs/node"
        },
        "meta": {
            "type": "object",
            "description": "Anything; decoders ignore it"
        }
    },
    "$defs": {
        "type": {
            "type": "string",
            "description": "A core type, or a reverse-DNS extension type such as org.example.theremin",
            "pattern": "^(sampler|sequencer|[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,})$"
        },
        "reference": {
            "type": "object",
            "description": "Stands in for the value it points to. These schemas accept references where they're most useful; decoders accept them for any value outside meta.",
            "additionalProperties": false,
            "required": [
                "$ref"
            ],
            "properties": {
                "$ref": {
                    "type": "string",
                    "pattern": "^#/defs/."
                },
                "label": {
                    "type": "string",
                    "description": "Overrides the referenced node's label"
                },
                "meta": {
                    "type": "object",
                    "description": "Overrides the referenced node's meta"
                }
            }
        },
        "node": {
            "description": "A node, or a reference to one. Its type selects the module that decodes it; the known ones are validated here, and nodes of other (extension) types only need a valid type.",
            "if": {
                "type": "object",
                "required": [
                    "$ref"
                ]
            },
            "then": {
                "$ref": "#/$defs/reference"
            },
            "else": {
                "type": "object",
                "required": [
                    "type"
                ],
                "properties": {
                    "type": {
                        "$ref": "#/$defs/type"
                    },
                    "label": {
                        "type": "string",
                        "description": "A human-readable name, for viewers and editors"
                    },
                    "meta": {
                        "type": "object",
                        "description": "Anything; decoders ignore it"
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "sampler"
                                }
                            }
                        },
                        "then": {
                            "$ref": "sampler.schema.json"
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "sequencer"
                                }
                            }
                        },
                        "then": {
                            "$ref": "sequencer.schema.json"
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "org.cochlea.gammatone"
                                }
                            }
                        },
                        "then": {
                            "$ref": "gammatone.schema.json"
                        }
                    }
                ]
            }
        }
    }
}
